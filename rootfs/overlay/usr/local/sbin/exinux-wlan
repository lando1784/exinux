#!/bin/sh
# qcacld-3.0 is built into the kernel but stays idle until someone writes
# "ON" to /dev/wlan; Android's Wi-Fi HAL normally does that.
set -e
case "$1" in
up)
    for i in $(seq 30); do [ -e /dev/wlan ] && break; sleep 1; done
    [ -e /dev/wlan ] || { echo "/dev/wlan never appeared" >&2; exit 1; }
    for f in qca6390/amss20.bin wlan/qcom_cfg.ini; do
        [ -e "/lib/firmware/$f" ] || echo "warning: /lib/firmware/$f missing, run scripts/extract-firmware.sh" >&2
    done
    echo ON > /dev/wlan
    for i in $(seq 30); do [ -d /sys/class/net/wlan0 ] && exit 0; sleep 1; done
    echo "wlan0 did not appear, see dmesg" >&2
    exit 1
    ;;
down)
    [ -e /dev/wlan ] && echo OFF > /dev/wlan || true
    ;;
*)
    echo "usage: $0 up|down" >&2; exit 2 ;;
esac
