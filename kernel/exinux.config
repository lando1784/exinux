# exinux kernel config fragment, merged on top of exynos9830_defconfig + r8s.config.
# Everything here is about running a normal GNU/Linux userspace (systemd, Xorg,
# BlueZ, NetworkManager) instead of Android's init.

CONFIG_LOCALVERSION="-exinux"
# CONFIG_LOCALVERSION_AUTO is not set

# --- systemd requirements ---
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# Android kernels call /sbin/hotplug for every uevent; udev handles that for us.
CONFIG_UEVENT_HELPER_PATH=""

# --- Xorg needs virtual terminals (no fbcon: the panel needs explicit refreshes) ---
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# --- Bluetooth profiles BlueZ expects (keyboards, mice, audio, tethering) ---
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_UHID=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# --- USB gadget: network + serial for debugging from a PC ---
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y

# --- Filesystems for SD cards and USB sticks ---
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
